[Unit]
Description=VLX-Seek 1.5-10B visual perception WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vlx-seek-deploy/VLX-Seek
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/vlx-seek-deploy/python-packages
Environment=VLX_MODEL_PATH=/home/ubuntu/vlx-seek-deploy/models/VLX-Seek-1.5-10B
Environment=VLX_DETECTOR_PATH=/home/ubuntu/vlx-seek-deploy/VLX-Seek/resources/wedetect_base_uni.pth
Environment=VLX_DEVICE_MAP=balanced
Environment=VLX_ATTN_IMPLEMENTATION=sdpa
Environment=HF_HOME=/home/ubuntu/vlx-seek-deploy/hf-cache
Environment=HF_ENDPOINT=https://hf-mirror.com
ExecStart=/home/ubuntu/JoyAI-VL-Interaction/services/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8099 --ssl-keyfile /home/ubuntu/JoyAI-VL-Interaction/services/webui/key.pem --ssl-certfile /home/ubuntu/JoyAI-VL-Interaction/services/webui/cert.pem --proxy-headers
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
