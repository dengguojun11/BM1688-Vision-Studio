# .env.example — 占位说明；实际配置见 config/env/
#   本地开发: config/env/.env.local  →  scripts/sync_local_env.ps1 复制为项目根 .env
#   服务器:   config/env/.env.server →  deploy.sh 自动安装到 labeIuMedia/.env
PASSWORD_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# 全局任务超级用户（逗号分隔用户名，与登录邮箱一致）：可访问/编辑任意任务、删任务、管理协同，无需被邀请为协同标注。
# 默认与内置管理员 admin@123.com 一致；多租户生产建议设为空或仅运维账号，例如：
# TASK_SUPERUSER_USERNAMES=
# TASK_SUPERUSER_USERNAMES=admin@123.com,ops@company.com

# 数据根目录（可选）。默认：当前用户 appdirs 目录 — Windows 多为
#   %LOCALAPPDATA%\labelu\labelu
# Linux 多为 ~/.local/share/labelu
# 服务器一键部署 deploy.sh 默认：
#   代码目录 /data/labeIU/labeIuproject
#   运行与媒体 /data/labeIU/labeIuMedia（.env 内 BASE_DATA_DIR 与 MEDIA_ROOT 均指向该路径）
# BASE_DATA_DIR=/data/labeIU/labeIuMedia
# MEDIA_ROOT=/data/labeIU/labeIuMedia
# 不设 DATABASE_URL 时，SQLite 库为 BASE_DATA_DIR/labelu.sqlite，上传文件在 BASE_DATA_DIR/media。
# 使用 MySQL 时仍可设 BASE_DATA_DIR，用于存放上传媒体与 YOLO 等工作目录。

# 登录会话 JWT 有效期（分钟）。默认约 7 天；需更久可加大，例如 30 天：TOKEN_ACCESS_EXPIRE_MINUTES=43200
# TOKEN_ACCESS_EXPIRE_MINUTES=10080
# 必须与浏览器访问地址一致（协议、主机、端口）。
# 使用 labelu --host/--port 启动时会自动覆盖并写回本文件（MEDIA_HOST_AUTO_SYNC=true，默认开启）。
# 例如：labelu --host 127.0.0.1 --port 8002 → MEDIA_HOST=http://127.0.0.1:8002
# MEDIA_HOST=http://127.0.0.1:8000
# MEDIA_HOST_AUTO_SYNC=true
# start_labelu_8003.py 为支持边端回连默认监听 0.0.0.0；可用以下变量限制监听或指定浏览器地址主机。
# LABELU_LISTEN_HOST=0.0.0.0
# LABELU_PUBLIC_HOST=127.0.0.1

# SQLite（默认；不设 DATABASE_URL 时自动使用 BASE_DATA_DIR/labelu.sqlite）
# DATABASE_URL=sqlite:////data/labelu/labelu.sqlite
# 开发模式安全：仅在 APP_ENV=development/test 时使用显式开发数据库地址覆盖 DATABASE_URL。
# 开发进程连接 MySQL 还必须显式设置 LABELU_ALLOW_DEV_MYSQL=true。
# LABELU_DEV_DATABASE_URL=sqlite:///./.tmp/labelu-dev.sqlite
# LABELU_ALLOW_DEV_MYSQL=false

# MySQL（示例：先创建库 CREATE DATABASE labelu CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;）
# 安装驱动: pip install "labelu[mysql]"   或单独 pip install pymysql / mysqlclient
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/labelu

# --- AI 自动标注 ---
# AI_AUTO_LABEL_ENABLED=true
# 本地模型服务（默认）：填写 model_server 暴露的地址，例如 http://127.0.0.1:5000/
# AI_PROVIDER=local_http
# AI_MODEL_ENDPOINT=http://127.0.0.1:5000/
# 通用视觉/全局标签保持较小输入；目标检测保留更多细节以识别远处小目标
# AI_VISION_MAX_IMAGE_SIDE=1536
# AI_BBOX_VISION_MAX_IMAGE_SIDE=2560
# Provider 运行时仅在端点、镜像和 HIL 证据完成后显式开启
# PROVIDER_RUNTIME_AUTO_REGISTER=false
#
# 云端视觉识别：优先在「系统管理→模型接入配置」配置火山方舟 Coding Plan。
# 以下环境变量仅供没有页面配置的旧部署兼容使用；千问已退出视觉识别链。
# AI_PROVIDER=vision_llm_chain
# VISION_VOLCENGINE_API_KEY=
# VISION_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 模型名或接入点 ID（不要写 volcengine/ 前缀；若写了，服务端会自动去掉）
# VISION_VOLCENGINE_MODEL=doubao-seed-2-1-pro-260915

# --- YOLO11 训练 ---
# EXPERIMENT_DATASET_MIN_SAMPLE_COUNT=20
# 第三方策略 S3 问题数据回流独立 Worker；生产迁移和预生产演练通过后再开启
# EXPERIMENT_DATASET_DEDICATED_WORKER_ENABLED=false
# 部署脚本开关（systemd 单元和 API fail-closed 注入，以它为准）
# LABELU_ENABLE_EXPERIMENT_DATASET_WORKER=0
# EXPERIMENT_DATASET_WORKER_INTERVAL_SECONDS=5
# EXPERIMENT_DATASET_WORKER_LEASE_SECONDS=300
# EXPERIMENT_DATASET_WORKER_BATCH_SIZE=1
# 等待模型/分类/更多图片的最短自动重试间隔（秒）
# EXPERIMENT_DATASET_WAITING_REQUEUE_SECONDS=30
# YOLO_TRAIN_ENABLED=true
# 缺 ultralytics 时是否用当前 Python 自动 pip install（默认 true；离线环境可设为 false 后手动安装）
# YOLO_AUTO_INSTALL_ULTRALYTICS=true
# 亦可：pip install ultralytics   或   pip install "labelu[yolo]"
# 新增/检查边端设备缺 paramiko 时自动 pip install，成功后继续 SSH 探测和环境准备（默认 true）
# EDGE_SSH_AUTO_INSTALL_PARAMIKO=true
# YOLO_EVAL_ENABLED=true
# YOLO_TRAIN_DEVICE=0
# 多卡时自动分配：小任务各占一卡并行，大任务双卡 DDP（默认开启）
# YOLO_TRAIN_GPU_AUTO_ALLOC=true
# YOLO_TRAIN_GPU_DUAL_SCORE_THRESHOLD=4.0
# 预训练权重目录（可选；目录内放 yolo11n.pt，避免从 GitHub 下载卡住）
# YOLO_PRETRAINED_WEIGHTS_DIR=/data/labeIU/labeIuproject/labeIU
# YOLO_TRAIN_WORKERS=0

# 手工 YOLO 批量预标注独立 Worker（默认关闭；开启前需完成数据库迁移并配置 systemd）
# YOLO_PREANNOTATE_DEDICATED_WORKER_ENABLED=false
# YOLO_PREANNOTATE_WORKER_INTERVAL_SECONDS=5
# YOLO_PREANNOTATE_WORKER_LEASE_SECONDS=900
# YOLO_PREANNOTATE_WORKER_BATCH_LIMIT=1
# YOLO_PREANNOTATE_MAX_CONCURRENT_JOBS=1
# Provider 预标注独立 Worker 默认关闭；真实模型、共享权重目录、MySQL 和 systemd 验收后才可开启
# PROVIDER_PREANNOTATE_DEDICATED_WORKER_ENABLED=false
# PROVIDER_PREANNOTATE_WORKER_INTERVAL_SECONDS=5
# PROVIDER_PREANNOTATE_WORKER_LEASE_SECONDS=900
# PROVIDER_PREANNOTATE_WORKER_BATCH_LIMIT=1
# PROVIDER_PREANNOTATE_MAX_CONCURRENT_JOBS=1
# AICM 发布独立 Worker 默认关闭；外部平台发布不可回滚，异常只能禁止后续下载
# AICM_PUBLISH_DEDICATED_WORKER_ENABLED=false
# AICM_PUBLISH_WORKER_INTERVAL_SECONDS=5
# AICM_PUBLISH_WORKER_LEASE_SECONDS=21600
# AICM_PUBLISH_WORKER_BATCH_LIMIT=1
# YOLO_TRAIN_AMP=false
# running 后长时间无 epoch/results 进展时终止训练子进程并标记失败，避免页面长期 0%
# YOLO_TRAIN_STALL_WATCHDOG_ENABLED=true
# YOLO_TRAIN_START_STALL_TIMEOUT_SECONDS=900
# YOLO_TRAIN_VAL_RATIO=0.2
# YOLO_TRAIN_TEST_RATIO=0.1
# 一致池要求预测框与人工框逐框 IoU 至少达到该值；NMS 仍使用 YOLO_GT_PRED_COMPARE_IOU
# YOLO_CONSISTENT_POOL_MATCH_IOU=0.8
# BM1688 导出优先从本作业训练集抽校准图（对齐文档 3.5）；无训练数据时回退 YOLO_BM1688_CALIBRATION_DATASET_DIR
# YOLO_BM1688_USE_JOB_CALIBRATION=true
# YOLO_BM1688_CALIBRATION_IMAGE_COUNT=128

# --- 策略演化第三方回调 ---
# 第三方结果接收服务根地址；LabelU 会回调
# {BASE_URL}/api/v1/strategy-evolution/platform-callbacks
# STRATEGY_EVOLUTION_OUTBOUND_CALLBACK_BASE_URL=http://third-party.example.com
# Task-type-specific receivers override the generic base URL. When set, an
# incoming callback_url must match its task type's configured receiver.
# STRATEGY_EVOLUTION_THRESHOLD_CALLBACK_URL=http://10.10.11.28:21087/api/v1/strategy-evolution/platform-callbacks
# STRATEGY_EVOLUTION_MODEL_CALLBACK_URL=http://10.10.11.28:21088/api/v1/strategy-evolution/platform-callbacks
# 回调 HMAC-SHA256 共享密钥。生产环境必须配置；默认拒绝无签名的入站和出站回调。
# STRATEGY_EVOLUTION_CALLBACK_HMAC_SECRET=replace-with-a-long-random-secret
# 策略演化内部查询/重试接口的服务令牌（推荐）。客户端使用
# X-7GAI-Service-Token，或 Authorization: Bearer <token>。
# STRATEGY_EVOLUTION_SERVICE_TOKEN=replace-with-a-long-random-service-token
# 内部查询接口默认强制服务令牌或回调 HMAC；仅测试/旧协议迁移可关闭。
# STRATEGY_EVOLUTION_INTERNAL_AUTH_REQUIRED=true
# 仅受控的本地开发或旧协议迁移可临时开启，生产环境必须保持 false。
# STRATEGY_EVOLUTION_ALLOW_UNSIGNED_CALLBACKS=false
# STRATEGY_EVOLUTION_CALLBACK_HMAC_MAX_SKEW_SECONDS=300
# THIRD_PARTY_REQUEST_MAX_BYTES=10485760
# THIRD_PARTY_RATE_LIMIT_PER_MINUTE=120
# 回调失败重试：最大次数、初始退避秒数、最大退避秒数。
# STRATEGY_EVOLUTION_CALLBACK_MAX_ATTEMPTS=8
# STRATEGY_EVOLUTION_CALLBACK_RETRY_BASE_SECONDS=30
# STRATEGY_EVOLUTION_CALLBACK_RETRY_MAX_SECONDS=1800

# --- AI 标注网页可调部分 ---
## VLX-Seek 1.5 图片预标注（本地与服务端统一使用 10.10.11.27）
# VLX_SEEK_ENABLED=false
# VLX_SEEK_ENDPOINT=https://10.10.11.27:8099/api/infer
# VLX_SEEK_VERIFY_TLS=false
# VLX_SEEK_TIMEOUT_SECONDS=300
# VLX_SEEK_MODEL=omlab/VLX-Seek-1.5-10B
# REX_OMNI_ENABLED=false
# REX_OMNI_ENDPOINT=https://10.10.11.27:8099/api/rex/infer
# REX_OMNI_VERIFY_TLS=false
# REX_OMNI_TIMEOUT_SECONDS=300
# REX_OMNI_MODEL=IDEA-Research/Rex-Omni-AWQ
# REX_OMNI_MAX_NEW_TOKENS=1024
# 附加提示词、内置链路勾选、以及「大模型档案」与调用顺序保存在 BASE_DATA_DIR 下 ai_labeling_runtime.json
# 浏览器打开 /ai-labeling-settings：可配置档案密钥（服务端 JSON）；仍可通过本文件配置火山/千问等内置链路
# YOLO AI 评估提示词保存在同目录 yolo_eval_prompts.json，亦在该站点内编辑

# --- 图像导入流水线（上传后聚类/离群/子场景，不改文件名）---
# 首次启动且 .env 中无下列键时，可自动写入 IMAGE_PIPELINE_ENABLED=true（见 IMAGE_PIPELINE_AUTO_CONFIGURE_ENV）
# IMAGE_PIPELINE_ENABLED=true
# 缺 opencv/sklearn 时是否自动 pip install（默认 true）
# IMAGE_PIPELINE_AUTO_INSTALL_DEPS=true
# 是否在 .env 缺失开关时自动写入启用项（默认 true；生产若需默认关闭可设为 false）
# IMAGE_PIPELINE_AUTO_CONFIGURE_ENV=true
# 可选外部 JSON 覆盖内置默认：IMAGE_PIPELINE_CONFIG_PATH=/path/to/config.json

# --- 应用日志（写入 BASE_DATA_DIR/logs/labelu.log、error.log）---
# 是否启用文件日志（stdout / systemd journal 始终保留）
# LOG_FILE_ENABLED=true
# 日志目录；留空则使用 BASE_DATA_DIR/logs
# LOG_DIR=
# 文件日志最低级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 全量日志保留时长（loguru retention，含空格的值须加双引号，例如 "30 days"）
# LOG_RETENTION="30 days"
# 错误日志 error.log 保留时长
# LOG_ERROR_RETENTION="90 days"
# 按天切分时刻（本地时区），默认每天 0 点
# LOG_ROTATION=00:00
# HTTP 访问日志是否包含 request_id、用户 ID、query 等详情
# LOG_HTTP_DETAIL=true
# 是否记录 /api/ 的 JSON 请求体与响应体（默认 false，避免大标注 JSON 拖慢接口；排障时可 true）
# LOG_HTTP_BODY=false
# 单条请求/响应体日志最大字符数（超出截断）
# LOG_HTTP_BODY_MAX_CHARS=2000
# 开启 LOG_HTTP_BODY 时，超过该字节的 body 只记长度、不整包解析（默认 64KB）
# LOG_HTTP_BODY_MAX_CAPTURE_BYTES=65536
# 是否输出 [biz] 业务步骤日志（API 路由 + 服务层异步入口自动记录）
# LOG_BUSINESS_DETAIL=true

# --- 7GAI 边端 Agent / OTA ---
# 生产启用 BOARD_AGENT_ENABLED 时必须配置随机注册凭据、OTA 签名密钥，并打开两个硬门禁。
# 统一 Board Agent 主链（设备可通过 SSH 自动安装；安装后由设备主动拉取任务）
# BOARD_AGENT_ENABLED=true
# BOARD_AGENT_PRIMARY_ENABLED=true
# BOARD_AGENT_TOKEN=replace-with-a-long-random-token
# BOARD_AGENT_HEARTBEAT_TTL_SECONDS=120
# 板端执行长任务时的驻留心跳间隔（默认30，建议不超过服务端 TTL 的一半）
# BOARD_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
# 边端必须能访问此地址；不要填 localhost、127.0.0.1 或 0.0.0.0。
# BOARD_AGENT_PUBLIC_BASE_URL=http://<服务器内网IP>:8003
# 页面自动配置会在开发环境生成并加密保存 Agent/任务签名密钥；如需固定任务签名密钥可显式设置。
# BOARD_AGENT_TASK_TOKEN_SECRET=replace-with-a-different-long-random-secret
# 新增/补全 SSH 设备后自动执行预检、运行时准备、Agent 安装和心跳确认。
# EDGE_AGENT_AUTO_BOOTSTRAP_ENABLED=true
# SEVEN_GAI_AGENT_ENROLLMENT_TOKEN=replace-with-a-long-random-token
# SEVEN_GAI_AGENT_OTA_SIGNING_KEY=replace-with-a-long-random-secret
# SEVEN_GAI_AGENT_REQUIRE_PROJECT=true
# SEVEN_GAI_AGENT_REQUIRE_OTA_SIGNATURE=true
# 设备监控中最后心跳超过该秒数的 ONLINE Agent 显示为 OFFLINE（只读投影）
# SEVEN_GAI_AGENT_OFFLINE_TTL_SECONDS=120
# 规则发布签名只证明服务端契约验签通过；真实设备验签仍需 HIL 证据。
# 兼容旧格式：{"rule-key-2026":"secret"} 等价于 ACTIVE。
# 状态化格式支持 ACTIVE/ROTATING/REVOKED/EXPIRED；ROTATING 必须设置轮换宽限截止时间。
# SEVEN_GAI_RULE_SIGNING_KEYS_JSON={"rule-key-2026":{"secret":"replace-with-a-long-random-secret","status":"ACTIVE","not_after":"2027-01-01T00:00:00Z"},"rule-key-2025":{"secret":"old-secret","status":"ROTATING","rotation_grace_until":"2026-12-01T00:00:00Z"}}
# SEVEN_GAI_RULE_REQUIRE_SIGNATURE=true

# --- 远程 GPU 训练 Agent 制品签名 ---
# 生产环境必须配置；密钥由平台通过 SSH 临时文件下发到受管 Agent，绝不写入作业清单或日志。
# YOLO_REMOTE_TRAIN_HMAC_SECRET=replace-with-a-long-random-secret
# YOLO_REMOTE_TRAIN_HMAC_KEY_ID=v1
# 开发环境默认兼容历史无签名 Agent；生产环境即使不打开此项也会强制要求签名。
# YOLO_REMOTE_TRAIN_HMAC_REQUIRED=false

# --- 模型制品清单（ModelManifest）服务端签名 ---
# 只用于 LabelU 服务与受管 Worker 的内部校验，禁止下发到 BM1688 设备。
# YOLO_MODEL_MANIFEST_HMAC_SECRET=replace-with-a-separate-long-random-secret
# YOLO_MODEL_MANIFEST_HMAC_KEY_ID=v1
# 开发环境默认兼容历史无签名清单；生产环境强制要求签名。
# YOLO_MODEL_MANIFEST_HMAC_REQUIRED=false

# --- BM1688 手动边端验证运行时自动预检/离线修复 ---
# 边端验证独立 Worker 默认关闭；开启后 Web 只分配设备，独立进程执行 SSH/推理/结果回传
# YOLO_EDGE_VALIDATION_DEDICATED_WORKER_ENABLED=false
# YOLO_EDGE_VALIDATION_DEDICATED_WORKER_INTERVAL_SECONDS=5
# YOLO_EDGE_VALIDATION_DEDICATED_WORKER_BATCH_LIMIT=1
# 以下为 deploy.sh 的独立 systemd Worker 开关；默认关闭，需真实设备和迁移证据后再开启
# LABELU_ENABLE_EDGE_VALIDATION_WORKER=0
# LABELU_EDGE_VALIDATION_WORKER_INTERVAL=5
# LABELU_EDGE_VALIDATION_WORKER_BATCH_LIMIT=1
# EDGE_RUNTIME_AUTO_PROVISION_ENABLED=true
# 边端所有 LabelU 创建、修改和清理的文件都必须位于该目录下
# EDGE_REMOTE_ROOT=/data/labelu_edge
# LabelU 服务端已有离线包；边端无需联网，服务端通过 SFTP 续传并按 SHA256 复用缓存
# EDGE_RUNTIME_OFFLINE_ARCHIVE=/data/labelu/edge_runtime/bm1688-edge-runtime-offline.tar
# 服务端本地没有包时可选下载地址（下载后缓存到 BASE_DATA_DIR/edge_runtime/offline_cache）
# EDGE_RUNTIME_OFFLINE_ARCHIVE_URL=
# EDGE_RUNTIME_OFFLINE_SHA256=
# EDGE_RUNTIME_REMOTE_ROOT=/data/labelu_edge/runtime
# EDGE_RUNTIME_MIN_FREE_MB=2048
# EDGE_RUNTIME_MIN_TMP_FREE_MB=256
# EDGE_RUNTIME_MIN_DOCKER_FREE_MB=512
# EDGE_RUNTIME_MIN_DATA_FREE_MB=2048
# EDGE_RUNTIME_MIN_FREE_INODES=1024
# EDGE_RUNTIME_AUTO_LOG_CLEANUP_ENABLED=true
# EDGE_RUNTIME_LOG_RETENTION_DAYS=7
# EDGE_RUNTIME_JOURNAL_MAX_MB=256
# EDGE_RUNTIME_PROVISION_TIMEOUT_SEC=3600
# EDGE_REMOTE_FAILED_JOB_RETENTION_HOURS=24
# EDGE_REMOTE_CLEANUP_INTERVAL_SECONDS=1800
# 标准性能基准：预热 50 次、正式重复 1000 次、每秒采集资源
# EDGE_PERFORMANCE_WARMUP_COUNT=50
# EDGE_PERFORMANCE_REPEAT_COUNT=1000
# EDGE_PERFORMANCE_RESOURCE_INTERVAL_SECONDS=1.0
# INT8 长稳运行秒数；默认 0 不执行，需要时例如设为 3600
# EDGE_PERFORMANCE_STABILITY_SECONDS=0
